# ─────────────────────────────────────────────────────────────────────────────
# AI Electronics Refurbishment & Resale Agent — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# Google Gemini API key (required)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model for text tasks
GEMINI_MODEL=gemini-1.5-flash

# Gemini model for vision / multimodal tasks
GEMINI_VISION_MODEL=gemini-1.5-pro

# ── MCP Mode ─────────────────────────────────────────────────────────────────
# Options: stdio | in_process
# Use "stdio" for local development (MCP servers as subprocesses)
# Use "in_process" for Hugging Face Spaces deployment
MCP_MODE=in_process

# ── Memory Backend ───────────────────────────────────────────────────────────
# Options: chromadb | pinecone
MEMORY_BACKEND=chromadb

# ChromaDB local persistence path (used when MEMORY_BACKEND=chromadb)
CHROMADB_PERSIST_PATH=./chroma_db

# Pinecone (required when MEMORY_BACKEND=pinecone)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=refurb-agent-memory

# Session memory TTL in seconds (default: 3600 = 1 hour)
SESSION_TTL_SECONDS=3600

# ── Observability ─────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/refurb_agent.log

# Enable execution tracing (true | false)
ENABLE_TRACING=true

# Directory where trace JSON files are saved
TRACE_OUTPUT_DIR=traces/

# ── Agent Config ──────────────────────────────────────────────────────────────
# Max seconds an agent step may take before timing out
AGENT_TIMEOUT_SECONDS=120

# Max retries for LLM and MCP calls
MAX_RETRIES=3

# Minimum evaluator score (0-10) to accept a report without re-run
EVALUATOR_MIN_SCORE=6.0

# ── UI (Gradio) ───────────────────────────────────────────────────────────────
GRADIO_SERVER_PORT=7860
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SHARE=false
